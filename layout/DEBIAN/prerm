#!/bin/sh
#
# TrollSpeed
#
# Only unload the daemon when launchd actually knows about it. Testing for the
# plist alone is not enough: on roothide the file lives under the per-boot
# .jbroot container path while the label may never have been loaded, and
# `launchctl unload` then reports "Could not find specified service".
#
# The HUD itself is stopped by postinst after unpacking, so an upgrade always
# ends up running the newly installed binary.
#

LABEL="ch.xxtou.hudservices"

for plist in /Library/LaunchDaemons/"$LABEL".plist \
             /var/jb/Library/LaunchDaemons/"$LABEL".plist; do
    [ -f "$plist" ] || continue
    launchctl list "$LABEL" >/dev/null 2>&1 || continue
    launchctl unload "$plist" >/dev/null 2>&1 || true
done

exit 0
